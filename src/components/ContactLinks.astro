---
import { SITE } from '../site';
---
<ul class="contact">
  <li><a href={SITE.github} rel="me noopener" target="_blank">GitHub</a></li>
  <li><a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
  <li>
    <a href={`mailto:${SITE.email}`} class="copy-email" data-email={SITE.email} title="Click to copy">Email</a>
    <span class="sr-only" role="status" aria-live="polite"></span>
  </li>
  <li><a href={SITE.resume} target="_blank" rel="noopener">Résumé</a></li>
</ul>

<style>
  .contact { display: flex; flex-wrap: wrap; gap: var(--s2) var(--s4); padding: 0; margin: 0; list-style: none; font-size: 0.875rem; }
  .contact a { color: var(--muted); text-decoration: none; transition: color 0.2s; }
  .contact a:hover { color: var(--accent); }
  .copy-email.copied { color: var(--accent); }
</style>

<script>
  function setup() {
    document.querySelectorAll<HTMLAnchorElement>('.copy-email').forEach((a) => {
      a.onclick = async (e) => {
        if (!navigator.clipboard) return; // fall back to mailto:
        e.preventDefault();
        const email = a.dataset.email!;
        const status = a.parentElement!.querySelector('[role=status]')!;
        try {
          await navigator.clipboard.writeText(email);
          a.classList.add('copied');
          a.textContent = 'Copied ' + email;
          status.textContent = 'Email address copied to clipboard';
          setTimeout(() => { a.classList.remove('copied'); a.textContent = 'Email'; status.textContent = ''; }, 2200);
        } catch { location.href = `mailto:${email}`; }
      };
    });
  }
  document.addEventListener('astro:page-load', setup);
</script>
