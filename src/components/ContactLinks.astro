---
import { Mail, FileText, Check } from '@lucide/astro';
import { SITE } from '../site';
---
<ul class="contact">
  <li>
    <a href={SITE.github} rel="me noopener" target="_blank">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
      GitHub
    </a>
  </li>
  <li>
    <a href={SITE.linkedin} rel="me noopener" target="_blank">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
      LinkedIn
    </a>
  </li>
  <li>
    <a href={`mailto:${SITE.email}`} class="copy-email" data-email={SITE.email}>
      <Mail size={15} aria-hidden="true" class="i-mail" />
      <Check size={15} aria-hidden="true" class="i-check" />
      <span class="label">{SITE.email}</span>
    </a>
    <span class="sr-only" role="status" aria-live="polite"></span>
  </li>
  <li>
    <a href={SITE.resume} target="_blank" rel="noopener">
      <FileText size={15} aria-hidden="true" />
      Résumé
    </a>
  </li>
</ul>

<style>
  .contact { display: flex; flex-wrap: wrap; gap: var(--s2) var(--s4); padding: 0; margin: 0; list-style: none; }
  .contact a {
    display: inline-flex; align-items: center; gap: 6px; color: var(--muted);
    text-decoration: none; font-size: 0.875rem; transition: color 0.2s;
  }
  .contact a:hover { color: var(--accent); }
  .i-check { display: none; color: var(--accent); }
  .copied .i-mail { display: none; }
  .copied .i-check { display: block; }
</style>

<script>
  function setup() {
    document.querySelectorAll<HTMLAnchorElement>('.copy-email').forEach((a) => {
      a.title = 'Click to copy';
      a.onclick = async (e) => {
        if (!navigator.clipboard) return; // fall back to mailto:
        e.preventDefault();
        const email = a.dataset.email!;
        const label = a.querySelector('.label')!;
        const status = a.parentElement!.querySelector('[role=status]')!;
        try {
          await navigator.clipboard.writeText(email);
          a.classList.add('copied');
          label.textContent = 'Copied!';
          status.textContent = 'Email address copied to clipboard';
          setTimeout(() => { a.classList.remove('copied'); label.textContent = email; status.textContent = ''; }, 1800);
        } catch { location.href = `mailto:${email}`; }
      };
    });
  }
  document.addEventListener('astro:page-load', setup);
</script>
