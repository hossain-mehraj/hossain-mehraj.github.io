---
import { X, ChevronLeft, ChevronRight } from '@lucide/astro';
---
<dialog class="lightbox" aria-label="Image viewer">
  <button class="lb-btn lb-close" type="button" aria-label="Close"><X size={20} /></button>
  <button class="lb-btn lb-prev" type="button" aria-label="Previous image"><ChevronLeft size={22} /></button>
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <button class="lb-btn lb-next" type="button" aria-label="Next image"><ChevronRight size={22} /></button>
  <p class="lb-count mono" aria-live="polite"></p>
</dialog>

<style>
  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: var(--s5) var(--s7);
    border: 0; background: rgb(8 10 14 / 0.96); color: #e6e9ee;
    display: none; align-items: center; justify-content: center;
  }
  .lightbox[open] { display: flex; animation: lb-in 0.2s ease-out; }
  .lightbox::backdrop { background: transparent; }
  @keyframes lb-in { from { opacity: 0; } }
  figure { margin: 0; display: flex; flex-direction: column; align-items: center; gap: var(--s3); max-width: 100%; max-height: 100%; }
  img { max-width: 100%; max-height: calc(100dvh - 160px); width: auto; height: auto; object-fit: contain; border-radius: 6px; }
  figcaption { max-width: 640px; text-align: center; font-size: 0.9375rem; color: #c2c8d1; }
  .lb-btn {
    position: absolute; display: grid; place-items: center; width: 44px; height: 44px;
    border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.15); background: rgb(255 255 255 / 0.06);
    color: #fff; cursor: pointer; transition: background 0.2s;
  }
  .lb-btn:hover { background: rgb(255 255 255 / 0.16); }
  .lb-btn:focus-visible { outline: 2px solid #8fb0ff; outline-offset: 2px; }
  .lb-close { top: var(--s3); right: var(--s3); }
  .lb-prev { left: var(--s3); top: 50%; translate: 0 -50%; }
  .lb-next { right: var(--s3); top: 50%; translate: 0 -50%; }
  .lb-count { position: absolute; bottom: var(--s3); left: 0; right: 0; text-align: center; margin: 0; color: #9aa3b0; }
  .single .lb-prev, .single .lb-next, .single .lb-count { display: none; }
  @media (max-width: 640px) {
    .lightbox { padding: var(--s6) var(--s2); }
    .lb-prev, .lb-next { top: auto; bottom: var(--s2); translate: none; }
  }
</style>

<script>
  function setup() {
    const dlg = document.querySelector<HTMLDialogElement>('dialog.lightbox');
    const all = [...document.querySelectorAll<HTMLImageElement>('.prose figure img, [data-lightbox] img')];
    if (!dlg || !all.length) return;
    const view = dlg.querySelector('img')!;
    const cap = dlg.querySelector('figcaption')!;
    const count = dlg.querySelector('.lb-count')!;
    let imgs = all;
    let i = 0;
    let opener: HTMLElement | null = null;

    const show = (n: number) => {
      i = (n + imgs.length) % imgs.length;
      const src = imgs[i];
      // Use the largest candidate Astro generated for this image.
      const set = (src.getAttribute('srcset') || '').split(',').map((s) => s.trim().split(/\s+/));
      const best = set.length && set[0][0] ? set.sort((a, b) => parseInt(b[1]) - parseInt(a[1]))[0][0] : src.currentSrc || src.src;
      view.src = best;
      view.alt = src.alt;
      cap.textContent = src.closest('figure')?.querySelector('figcaption')?.textContent ?? '';
      count.textContent = `${i + 1} / ${imgs.length}`;
    };

    all.forEach((img) => {
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.setAttribute('aria-label', `View larger: ${img.alt}`);
      const open = () => {
        // Only step through images that are visible (e.g. in the current tab).
        imgs = all.filter((x) => x.offsetParent !== null);
        dlg.classList.toggle('single', imgs.length < 2);
        opener = img; show(Math.max(0, imgs.indexOf(img))); dlg.showModal();
      };
      img.onclick = open;
      img.onkeydown = (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } };
    });

    dlg.querySelector<HTMLButtonElement>('.lb-close')!.onclick = () => dlg.close();
    dlg.querySelector<HTMLButtonElement>('.lb-prev')!.onclick = () => show(i - 1);
    dlg.querySelector<HTMLButtonElement>('.lb-next')!.onclick = () => show(i + 1);
    dlg.onclick = (e) => { if (e.target === dlg) dlg.close(); };
    dlg.onkeydown = (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    };
    dlg.onclose = () => opener?.focus();
  }
  document.addEventListener('astro:page-load', setup);
</script>
