---
import { icons } from '@lucide/astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { name: string; thumbnail?: ImageMetadata; size?: number; class?: string }
const { name, thumbnail, size = 22, class: cls } = Astro.props;
const pascal = name.split('-').map((p) => p.charAt(0).toUpperCase() + p.slice(1)).join('');
const Icon = (icons as Record<string, any>)[pascal] ?? icons.Box;
---
<span class:list={['project-icon', cls, { 'has-thumb': thumbnail }]}>
  {thumbnail
    ? <Image src={thumbnail} alt="" width={96} height={96} layout="fixed" fit="cover" />
    : <Icon size={size} stroke-width={1.6} aria-hidden="true" />}
</span>

<style>
  .project-icon {
    display: inline-grid; place-items: center; flex: none;
    width: 44px; height: 44px; border-radius: 10px;
    color: var(--accent); background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 14%, transparent);
    overflow: hidden;
  }
  .project-icon.has-thumb { background: var(--surface); }
  .project-icon :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .project-icon.lg { width: 56px; height: 56px; border-radius: 12px; }
</style>
