---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getProjects } from '../lib/projects';
const featured = (await getProjects()).filter((p) => p.data.featured);
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <div class="container nf">
    <p class="mono code">404</p>
    <h1>This page doesn't exist.</h1>
    <p class="muted">It may have moved when the site was rebuilt. Try one of these, or <a href="/">go home</a>.</p>
    <ul class="list">{featured.map((p) => <ProjectRow project={p} />)}</ul>
  </div>
</Base>

<style>
  .nf { padding-top: var(--s5); min-height: 60vh; }
  .code { color: var(--accent); margin-bottom: var(--s2); }
  h1 { font-size: 1.5rem; letter-spacing: -0.02em; margin-bottom: var(--s2); }
  .list { padding: 0; margin-top: var(--s5); }
</style>
