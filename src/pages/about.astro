---
import Base from '../layouts/Base.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { SITE } from '../site';

const skills = [
  { group: 'Design & CAD', items: ['Onshape', 'Fusion 360', 'AutoCAD', 'Engineering drawings (GD&T, section & auxiliary views)', 'Assemblies & BOMs'] },
  { group: 'Simulation', items: ['CFD: Ansys Fluent (steady-state RANS)', 'Ansys Discovery', 'Mesh setup & post-processing'] },
  { group: 'Manufacturing', items: ['Manual lathe & mill', 'CNC milling (Mastercam)', '3-axis CNC routing', 'CAM toolpaths', '3D printing (FDM, SLA, SLS; PLA, PETG, CF-filled)', 'Tolerances to ±0.005 in'] },
  { group: 'Electronics', items: ['Soldering', 'Keyboard PCBs & switch modding', 'Fault tracing & repair'] },
  { group: 'Project & business', items: ['Project charters & WBS', 'Gantt scheduling', 'Risk registers', 'Budgeting', 'Sponsorship outreach ($11,600 raised)', 'Running a small business since 2022'] },
  { group: 'Software', items: ['TODO: languages / frameworks used for the clinic app'] },
];

const experience = [
  { role: 'Design, Manufacturing & Operations Lead', org: 'Team Lux, STEM Racing', dates: 'Nov 2025 – Apr 2026', text: '4th in Canada at the 2026 National Championships; 1st Best Pit Display. Led car design, CFD and machining, and ran operations and sponsorship.' },
  { role: 'Founder & builder', org: 'Custom Mechanical Keyboard Services', dates: 'Dec 2022 – present', text: '22 client builds: brief, parts spec, CNC case design, assembly, and repair.' },
  { role: 'TODO: role', org: 'Clinic staff mobile app', dates: 'TODO: dates', text: 'Built a mobile app that replaced a paper patient-information binder. TODO: details.' },
  { role: 'TODO: role', org: 'TODO: any jobs, internships, or shop/club positions', dates: 'TODO', text: 'TODO' },
];
---
<Base title="About" description={`About ${SITE.name}: engineering student at the University of Toronto. Skills in CAD, CFD, CNC machining, 3D printing and electronics.`}>
  <div class="container about">
    <h1>About</h1>
    <div class="prose">
      <p>
        I'm an engineering student at the University of Toronto. I design parts, simulate them, and then make them:
        a nationally ranked CO₂ race car, 22 custom keyboards built for clients, and three years of lathe, mill, and CNC work held to ±0.005 inches.
      </p>
      <p>
        I like projects where the drawing has to survive contact with the shop. Most of what I know came from a part not
        coming out the way I drew it, and working out why.
      </p>
      <p><!-- TODO: program/year at U of T, what you're looking for (co-op/internship terms), and interests outside engineering. -->TODO: add your program and year at U of T, what kind of roles you're looking for, and anything outside engineering.</p>
    </div>

    <h2 class="section-label">Skills</h2>
    <dl class="skills">
      {skills.map((s) => (
        <div>
          <dt>{s.group}</dt>
          <dd><ul class="tags">{s.items.map((i) => <li class="tag">{i}</li>)}</ul></dd>
        </div>
      ))}
    </dl>

    <h2 class="section-label">Experience</h2>
    <ol class="xp">
      {experience.map((x) => (
        <li>
          <div class="xp-head"><span class="xp-role">{x.role}</span><span class="mono muted">{x.dates}</span></div>
          <div class="muted">{x.org}</div>
          <p>{x.text}</p>
        </li>
      ))}
    </ol>

    <h2 class="section-label">Contact</h2>
    <ContactLinks />
  </div>
</Base>

<style>
  .about { padding-top: var(--s4); }
  h1 { font-size: 1.5rem; letter-spacing: -0.02em; margin-bottom: var(--s4); }
  .section-label { font-size: 0.875rem; font-weight: 500; font-family: var(--font-sans); color: var(--muted); margin: var(--s7) 0 var(--s3); }
  .skills { margin: 0; display: grid; gap: var(--s4); }
  .skills dt { font-weight: 500; margin-bottom: 2px; }
  .skills dd { margin: 0; }
  .skills .tags { row-gap: 2px; }
  .xp-role { font-weight: 500; }
  .xp { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s5); }
  .xp-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s2); }
  .xp p { margin: var(--s2) 0 0; }
</style>
