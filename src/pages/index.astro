---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { getProjects } from '../lib/projects';
import { SITE } from '../site';

const projects = await getProjects();
---
<Base>
  <div class="container home">
    <section class="intro">
      <h1>{SITE.name}</h1>
      <p class="muted">{SITE.tagline}</p>
      <p>
        I like seeing how engineering and the people it serves come together. That's meant running a
        custom keyboard business for 22 clients and leading design on a CO₂ race car with a team of nine.
      </p>
      <p>
        Looking for a summer 2027 internship.
      </p>
    </section>

    <section aria-labelledby="projects-h">
      <h2 id="projects-h" class="label">Projects</h2>
      <ul class="list">{projects.map((p) => <ProjectRow project={p} />)}</ul>
    </section>

    <ContactLinks />
  </div>
</Base>

<style>
  .home { padding-top: var(--s4); }
  .intro { margin-bottom: var(--s5); }
  h1 { font-size: 1.125rem; font-weight: 600; letter-spacing: -0.01em; }
  .intro p { margin: 0 0 var(--s3); }
  .intro .muted { margin-bottom: var(--s4); }
  .label { font-size: 0.875rem; font-weight: 500; color: var(--muted); letter-spacing: 0; margin: 0 0 var(--s2); }
  .list { padding: 0; margin: 0 0 var(--s5); }
</style>
