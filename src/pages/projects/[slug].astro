---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.data.slug },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const links = [
  p.links?.github && { label: 'GitHub', url: p.links.github },
  p.links?.live && { label: 'Live', url: p.links.live },
  ...(p.links?.other ?? []),
].filter(Boolean) as { label: string; url: string }[];
const meta = [p.role, p.dates, p.team].filter(Boolean);
---
<Base title={p.title} description={p.summary} ogImage={p.heroImage} ogImageAlt={p.heroAlt} type="article">
  <article class="container project">
    <a class="back" href="/">← All projects</a>

    <header class="project-header">
      <h1>{p.title}</h1>
      <p class="lede">{p.summary}</p>
      <p class="meta mono">{meta.join(' · ')}</p>
      {p.tools && <p class="meta mono">{p.tools.join(', ')}</p>}
      <ul class="tags" aria-label="Tags">{p.tags.map((t) => <li class="tag">{t}</li>)}</ul>
      {links.length > 0 && (
        <p class="links">{links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}</p>
      )}
    </header>

    {p.heroImage && (
      <figure class="hero" data-lightbox transition:name={`thumb-${p.slug}`}>
        <Image src={p.heroImage} alt={p.heroAlt!} loading="eager" fetchpriority="high" widths={[480, 640, 960, 1280, 1920]} sizes="(min-width: 700px) 640px, 100vw" />
        {p.heroCaption && <figcaption>{p.heroCaption}</figcaption>}
      </figure>
    )}

    {p.stats && (
      <dl class="stats">
        {p.stats.map((s) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}
      </dl>
    )}

    <div class="prose">
      <Content />
    </div>

    <nav class="pager" aria-label="More projects">
      <a href={`/projects/${prev.data.slug}/`} rel="prev"><span class="muted">← Previous</span> {prev.data.title}</a>
      <a href={`/projects/${next.data.slug}/`} rel="next" class="next">{next.data.title} <span class="muted">Next →</span></a>
    </nav>
    <p class="all"><a class="back" href="/">← Back to all projects</a></p>
  </article>
  <Lightbox />
</Base>

<style>
  .project { padding-top: var(--s3); padding-bottom: var(--s5); }
  .back { color: var(--muted); text-decoration: none; font-size: 0.875rem; }
  .back:hover { color: var(--accent); }
  .project-header { margin: var(--s6) 0 var(--s5); }
  h1 { font-size: 1.5rem; letter-spacing: -0.02em; }
  .lede { color: var(--muted); margin: var(--s2) 0 var(--s4); }
  .meta { color: var(--muted); font-size: 0.75rem; margin: 0 0 var(--s1); }
  .tags { margin-top: var(--s1); }
  .links { display: flex; gap: var(--s3); margin: var(--s3) 0 0; font-size: 0.875rem; }

  .hero { margin: 0 0 var(--s5); }
  .hero :global(img) { width: 100%; height: auto; border-radius: 6px; cursor: zoom-in; background: var(--hover); }
  .hero figcaption { margin-top: var(--s2); color: var(--muted); font-size: 0.8125rem; }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: var(--s4); margin: 0 0 var(--s7); }
  .stats dt { font-weight: 500; }
  .stats dd { margin: 2px 0 0; color: var(--muted); font-size: 0.8125rem; line-height: 1.45; }

  .pager {
    display: flex; justify-content: space-between; gap: var(--s4); margin-top: var(--s8);
    padding-top: var(--s4); border-top: 1px solid var(--border); font-size: 0.875rem;
  }
  .pager a { color: var(--text); text-decoration: none; display: flex; flex-direction: column; gap: 2px; }
  .pager a:hover { color: var(--accent); }
  .pager .next { text-align: right; flex-direction: column-reverse; }
  .all { margin-top: var(--s5); font-size: 0.875rem; }
</style>
