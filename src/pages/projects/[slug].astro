---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.data.slug },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const links = [
  p.links?.github && { label: 'GitHub', url: p.links.github },
  p.links?.live && { label: 'Live', url: p.links.live },
  ...(p.links?.other ?? []),
].filter(Boolean) as { label: string; url: string }[];
const tabs = p.tabs ?? [];
const hasTabs = tabs.length > 1;
const meta = (hasTabs ? [p.dates, p.team] : [p.role, p.dates, p.team]).filter(Boolean);

// Pre-paint tab selection: a stylesheet that shows only the [data-tab] matching <html data-tab>.
const tabCss = hasTabs
  ? `html[data-tab] [data-tab]{display:none}` +
    tabs.map((t) => `html[data-tab="${t.id}"] [data-tab="${t.id}"]{display:block}`).join('')
  : '';
const tabIds = JSON.stringify(tabs.map((t) => t.id));

type Stat = { value: string; label: string };
---
<Base title={p.title} description={p.summary} ogImage={p.heroImage ?? tabs[0]?.heroImage} ogImageAlt={p.heroAlt ?? tabs[0]?.heroAlt} type="article">
  <article class="container project">
    <a class="back" href="/">← All projects</a>

    <header class="project-header">
      <h1>{p.title}</h1>
      <p class="lede">{p.summary}</p>
      <p class="meta mono">{meta.join(' · ')}</p>
      {!hasTabs && p.tools && <p class="meta mono">{p.tools.join(', ')}</p>}
      <ul class="tags" aria-label="Tags">{p.tags.map((t) => <li class="tag">{t}</li>)}</ul>
      {links.length > 0 && (
        <p class="links">{links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}</p>
      )}
    </header>

    {hasTabs ? (
      <Fragment>
        <style is:inline set:html={tabCss}></style>
        <div data-tab-anchor aria-hidden="true"></div>
        <nav class="tabbar" role="tablist" aria-label="Project sections" data-tabbar>
          {tabs.map((t, i) => (
            <a id={`tab-${t.id}`} href={`#${t.id}`} role="tab" aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab-btn={t.id}>{t.label}</a>
          ))}
        </nav>
        <script is:inline define:vars={{ tabIds }}>
          (function () {
            var ids = JSON.parse(tabIds), h = location.hash.slice(1);
            document.documentElement.dataset.tab = ids.indexOf(h) > -1 ? h : ids[0];
          })();
        </script>
        {tabs.map((t, i) => (
          <div class="tab-head" data-tab={t.id} id={t.id}>
            <p class="tab-role mono">{[t.role, t.tools?.join(', ')].filter(Boolean).join(' · ')}</p>
            {t.heroImage && (
              <figure class="hero" data-lightbox transition:name={i === 0 ? `thumb-${p.slug}` : undefined}>
                <Image src={t.heroImage as ImageMetadata} alt={t.heroAlt ?? ''} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} widths={[480, 640, 960, 1280, 1920]} sizes="(min-width: 700px) 640px, 100vw" />
                {t.heroCaption && <figcaption>{t.heroCaption}</figcaption>}
              </figure>
            )}
            {t.stats && <dl class="stats">{(t.stats as Stat[]).map((s) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}</dl>}
          </div>
        ))}
      </Fragment>
    ) : (
      <Fragment>
        {p.heroImage && (
          <figure class="hero" data-lightbox transition:name={`thumb-${p.slug}`}>
            <Image src={p.heroImage} alt={p.heroAlt!} loading="eager" fetchpriority="high" widths={[480, 640, 960, 1280, 1920]} sizes="(min-width: 700px) 640px, 100vw" />
            {p.heroCaption && <figcaption>{p.heroCaption}</figcaption>}
          </figure>
        )}
        {p.stats && <dl class="stats">{p.stats.map((s) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}</dl>}
      </Fragment>
    )}

    <div class="prose">
      <Content />
    </div>

    <nav class="pager" aria-label="More projects">
      <a href={`/projects/${prev.data.slug}/`} rel="prev"><span class="muted">← Previous</span> {prev.data.title}</a>
      <a href={`/projects/${next.data.slug}/`} rel="next" class="next">{next.data.title} <span class="muted">Next →</span></a>
    </nav>
    <p class="all"><a class="back" href="/">← Back to all projects</a></p>
  </article>
  <Lightbox />
</Base>

<script>
  function setupTabs() {
    const bar = document.querySelector<HTMLElement>('[data-tabbar]');
    if (!bar) return;
    const root = document.documentElement;
    const btns = [...bar.querySelectorAll<HTMLAnchorElement>('[data-tab-btn]')];
    const ids = btns.map((b) => b.dataset.tabBtn!);

    const select = (id: string, opts: { focus?: boolean; scroll?: boolean } = {}) => {
      if (!ids.includes(id)) return;
      root.dataset.tab = id;
      btns.forEach((b) => {
        const on = b.dataset.tabBtn === id;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        if (on && opts.focus) b.focus();
      });
      history.replaceState(history.state, '', `#${id}`);
      // If the reader has scrolled past the tab bar, bring the new tab's start into view.
      const anchor = document.querySelector('[data-tab-anchor]')!;
      const top = anchor.getBoundingClientRect().top + scrollY;
      if (opts.scroll && scrollY > top) scrollTo({ top, behavior: 'instant' as ScrollBehavior });
    };

    select(root.dataset.tab || ids[0]);
    btns.forEach((b, i) => {
      b.onclick = (e) => { e.preventDefault(); select(b.dataset.tabBtn!, { scroll: true }); };
      b.onkeydown = (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        select(ids[(i + step + ids.length) % ids.length], { focus: true, scroll: true });
      };
    });
    // In-content links such as [Enterprise](#enterprise) switch tabs too.
    document.querySelectorAll<HTMLAnchorElement>('.prose a[href^="#"]').forEach((a) => {
      const id = a.getAttribute('href')!.slice(1);
      if (ids.includes(id)) a.onclick = (e) => { e.preventDefault(); select(id, { scroll: true }); bar.scrollIntoView(); };
    });
  }
  document.addEventListener('astro:page-load', setupTabs);
</script>

<style>
  .project { padding-top: var(--s3); padding-bottom: var(--s5); }
  .back { color: var(--muted); text-decoration: none; font-size: 0.875rem; }
  .back:hover { color: var(--accent); }
  .project-header { margin: var(--s6) 0 var(--s5); }
  h1 { font-size: 1.5rem; letter-spacing: -0.02em; }
  .lede { color: var(--muted); margin: var(--s2) 0 var(--s4); }
  .meta { color: var(--muted); font-size: 0.75rem; margin: 0 0 var(--s1); }
  .tags { margin-top: var(--s1); }
  .links { display: flex; gap: var(--s3); margin: var(--s3) 0 0; font-size: 0.875rem; }

  /* Tabs: plain text, active one underlined. Sticky so you can switch from anywhere. */
  .tabbar {
    position: sticky; top: 0; z-index: 5;
    display: flex; gap: var(--s4);
    margin: 0 0 var(--s4); padding-top: var(--s2);
    background: var(--bg); border-bottom: 1px solid var(--border);
  }
  .tabbar a {
    padding: var(--s1) 0 10px; margin-bottom: -1px;
    color: var(--muted); text-decoration: none; font-size: 0.9375rem;
    border-bottom: 1.5px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .tabbar a:hover { color: var(--text); }
  .tabbar a[aria-selected='true'] { color: var(--text); border-color: currentColor; }
  .tab-head { scroll-margin-top: 56px; }
  .tab-role { color: var(--muted); font-size: 0.75rem; margin: 0 0 var(--s4); }

  .hero { margin: 0 0 var(--s5); }
  .hero :global(img) { width: 100%; height: auto; border-radius: 6px; cursor: zoom-in; background: var(--hover); }
  .hero figcaption { margin-top: var(--s2); color: var(--muted); font-size: 0.8125rem; }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: var(--s4); margin: 0 0 var(--s7); }
  .stats dt { font-weight: 500; }
  .stats dd { margin: 2px 0 0; color: var(--muted); font-size: 0.8125rem; line-height: 1.45; }

  .pager {
    display: flex; justify-content: space-between; gap: var(--s4); margin-top: var(--s8);
    padding-top: var(--s4); border-top: 1px solid var(--border); font-size: 0.875rem;
  }
  .pager a { color: var(--text); text-decoration: none; display: flex; flex-direction: column; gap: 2px; }
  .pager a:hover { color: var(--accent); }
  .pager .next { text-align: right; flex-direction: column-reverse; }
  .all { margin-top: var(--s5); font-size: 0.875rem; }
</style>
